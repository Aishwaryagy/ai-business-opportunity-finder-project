# 1. APPLICATION ENVIRONMENT
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# 2. SUPABASE POSTGRESQL DATABASE CONFIGURATION
# Provide your Supabase PostgreSQL connection string (Transaction or Session Pooler / Direct URI).
# Example: postgresql://postgres.[project-ref]:[your-password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Leave blank during local development to automatically use the local SQLite fallback (business_opportunity.db)
# until your Supabase connection string is configured.
DATABASE_URL=your_supabase_postgresql_connection_string

# 3. OPTIONAL: HOSTED AI / LLM PROVIDER (Google Gemini or OpenAI)
# When configured, the Opportunity Service & Report Assistant can enrich reports
# and answer custom questions using the hosted LLM in addition to local NLP.
# Leave blank to use the built-in Rule-Based + Local VADER NLP Engine.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash

# 3B. MULTI-LAYER PROMPT CACHING & CONTEXT CACHING
# Enables L1 In-Memory LRU + L2 Database deterministic prompt caching and
# Canonical Static Prefix alignment (>1,024 tokens) for Gemini / OpenAI prefix caching.
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_TTL_MINUTES=1440
PROMPT_CACHE_MAX_MEM_ITEMS=256
GEMINI_CONTEXT_CACHE_TTL_SECONDS=3600

# 4. OPTIONAL: EXTERNAL MARKET-DATA API (NewsAPI.org)
# When configured, market_data_service.py queries NewsAPI.org in addition to
# public Google News RSS feeds.
# Leave blank to use public Google News RSS + clearly labelled fallback dataset.
MARKET_DATA_API_KEY=
MARKET_DATA_CACHE_TTL_MINUTES=60

# 5. OPTIONAL: EXCHANGE-RATE API KEY (ExchangeRate-API.com)
# Leave blank to use free unauthenticated open.er-api.com / api.frankfurter.dev
# endpoints (with automatic fallback to dated reference rates when offline).
EXCHANGE_RATE_API_KEY=
FX_CACHE_TTL_MINUTES=360

# 6. OPTIONAL: OUTGOING EMAIL (SMTP) FOR PASSWORDLESS OTP LOGIN
# Leave blank to test locally (the login screen will display an explicit
# development-mode notice and allow local verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Opportunity Intelligence Global
